@* The session's modal host (rendered once, by AppShell). Use it through UiFeedback. *@
@inject UiFeedback Feedback
@implements IDisposable

@switch (current)
{
    case ConfirmRequest c:
        <Modal Title="@c.Title" Size="modal-small" OnClose="c.Cancel">
            <p>@c.Message</p>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="c.Cancel">Cancel</button>
                <button class="@(c.Danger ? "btn-danger" : "btn-primary")" @onclick="() => c.Result.TrySetResult(true)">@c.ConfirmLabel</button>
            </div>
        </Modal>
        break;

    case ConflictRequest r:
        <Modal Title="File conflict" OnClose="r.Cancel">
            <p><strong>@r.Name</strong> already exists at the destination.</p>
            <p class="conflict-path">@r.Destination</p>
            <p>What do you want to do?</p>
            <div class="conflict-actions">
                <button class="btn-primary" @onclick="() => r.Result.TrySetResult(ConflictResolution.Replace)">Replace</button>
                <button class="btn-secondary" @onclick="() => r.Result.TrySetResult(ConflictResolution.KeepBoth)">Keep both</button>
                <button class="btn-secondary" @onclick="r.Cancel">Cancel</button>
            </div>
        </Modal>
        break;

    case ErrorRequest e:
        <Modal Title="Error" IsError="true" OnClose="e.Cancel">
            <p class="error-message">@e.Message</p>
            <div class="modal-actions">
                <button class="btn-primary" @onclick="e.Cancel">OK</button>
            </div>
        </Modal>
        break;

    case FolderRequest f:
        <FolderBrowser InitialPath="@f.InitialPath"
                       OnSelect="path => f.Result.TrySetResult(path)"
                       OnCancel="f.Cancel" />
        break;
}

@code {
    // One modal at a time; requests made while one is open wait their turn.
    private readonly SemaphoreSlim gate = new(1, 1);
    private Request? current;

    // Each request knows the answer that means "dismissed", used by Cancel/close and on dispose.
    private abstract record Request
    {
        public abstract void Cancel();
    }

    private abstract record Request<T>(T Dismissed) : Request
    {
        public TaskCompletionSource<T> Result { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
        public override void Cancel() => Result.TrySetResult(Dismissed);
    }

    private sealed record ConfirmRequest(string Title, string Message, string ConfirmLabel, bool Danger) : Request<bool>(false);
    private sealed record ConflictRequest(string Name, string Destination) : Request<ConflictResolution>(ConflictResolution.Cancel);
    private sealed record ErrorRequest(string Message) : Request<bool>(true);
    private sealed record FolderRequest(string? InitialPath) : Request<string?>((string?)null);

    protected override void OnInitialized() => Feedback.Dialogs = this;

    internal Task<bool> ConfirmAsync(string title, string message, string confirmLabel, bool danger) =>
        ShowAsync(new ConfirmRequest(title, message, confirmLabel, danger));

    internal Task<ConflictResolution> ResolveConflictAsync(string name, string destination) =>
        ShowAsync(new ConflictRequest(name, destination));

    internal Task ShowErrorAsync(string message) => ShowAsync(new ErrorRequest(message));

    internal Task<string?> PickFolderAsync(string? initialPath) => ShowAsync(new FolderRequest(initialPath));

    private async Task<T> ShowAsync<T>(Request<T> request)
    {
        await gate.WaitAsync();
        try
        {
            await InvokeAsync(() =>
            {
                current = request;
                StateHasChanged();
            });
            return await request.Result.Task;
        }
        finally
        {
            await InvokeAsync(() =>
            {
                current = null;
                StateHasChanged();
            });
            gate.Release();
        }
    }

    public void Dispose()
    {
        if (Feedback.Dialogs == this) Feedback.Dialogs = null;
        // Unblock anything still waiting on a dialog.
        current?.Cancel();
    }
}
