@* The session's toast (rendered once, by AppShell). Use it through UiFeedback.ShowToast. *@
@inject UiFeedback Feedback
@implements IDisposable

@if (message != null)
{
    <div class="toast @(isError ? "error" : "")">@message</div>
}

@code {
    private string? message;
    private bool isError;
    private CancellationTokenSource? hideCts;

    protected override void OnInitialized() => Feedback.Toast = this;

    // A new toast replaces the current one and restarts the timer, so overlapping toasts no
    // longer hide each other early.
    internal void Show(string text, bool error = false)
    {
        hideCts?.Cancel();
        var cts = hideCts = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            message = text;
            isError = error;
            StateHasChanged();
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2.5), cts.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            message = null;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (Feedback.Toast == this) Feedback.Toast = null;
        hideCts?.Cancel();
    }
}
