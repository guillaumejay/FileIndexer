@inject CollectionService CollectionService

<Modal Title="@(isNew ? "New Collection" : "Edit Collection")" OnClose="OnCancel">
    <div class="form-group">
        <label>Name</label>
        <input type="text" @bind="name" @bind:event="oninput" placeholder="Collection name" />
        @if (!string.IsNullOrEmpty(nameError))
        {
            <span class="field-error">@nameError</span>
        }
    </div>

    <div class="form-group">
        <label>Description (optional)</label>
        <input type="text" @bind="description" placeholder="Brief description" />
    </div>

    <div class="form-group">
        <label>Paths</label>
        <div class="path-list">
            @foreach (var path in paths)
            {
                <div class="path-entry">
                    <span class="path-text" title="@path.Path">📁 @UiFormat.TruncatePath(path.Path, 45)</span>
                    <button class="btn-icon-sm btn-danger-icon" @onclick="() => RemovePath(path)" title="Remove">✕</button>
                </div>
            }
        </div>
        <div class="add-path-row">
            <input type="text" @bind="newPath" @bind:event="oninput" placeholder="Enter directory path" @onkeyup="OnPathKeyUp" />
            <button class="btn-secondary" @onclick="Browse" title="Browse...">📂</button>
            <button class="btn-secondary" @onclick="AddPath" disabled="@string.IsNullOrWhiteSpace(newPath)">Add</button>
        </div>
        @if (!string.IsNullOrEmpty(pathError))
        {
            <span class="field-error">@pathError</span>
        }
        @if (overlaps.Count > 0)
        {
            <div class="overlap-warning">
                <span>⚠️ Path overlaps with:</span>
                <ul>
                    @foreach (var overlap in overlaps)
                    {
                        <li>@overlap.CollectionName: @overlap.Path</li>
                    }
                </ul>
                <span class="warning-note">Files may be indexed in multiple collections.</span>
            </div>
        }
    </div>

    <div class="form-group">
        <label>Excluded directories (one per line)</label>
        <textarea @bind="excludedDirectories" rows="3" placeholder="__MACOSX&#10;.Trash-1000&#10;node_modules"></textarea>
        <span class="field-hint">Folders with these names are skipped during indexing, with everything inside them.</span>
    </div>

    <div class="modal-actions">
        <button class="btn-secondary" @onclick="OnCancel">Cancel</button>
        <button class="btn-primary" @onclick="Save" disabled="@string.IsNullOrWhiteSpace(name)">
            @(isNew ? "Create" : "Save")
        </button>
    </div>
</Modal>

<Dialogs @ref="dialogs" />

@code {
    [Parameter] public Collection? Collection { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Dialogs dialogs = default!;
    private bool isNew => Collection == null;
    private string name = "";
    private string? description;
    private string excludedDirectories = "__MACOSX";
    private List<CollectionPath> paths = new();
    private List<int> removedPathIds = new();
    private string newPath = "";
    private string? nameError;
    private string? pathError;
    private List<PathOverlap> overlaps = new();

    protected override void OnParametersSet()
    {
        name = Collection?.Name ?? "";
        description = Collection?.Description;
        excludedDirectories = Collection?.ExcludedDirectories ?? "__MACOSX";
        paths = Collection?.Paths.ToList() ?? new();
        removedPathIds = new();
        newPath = "";
        nameError = null;
        pathError = null;
        overlaps = new();
    }

    private async Task AddPath()
    {
        pathError = null;
        overlaps = new();

        if (string.IsNullOrWhiteSpace(newPath)) return;

        var trimmedPath = newPath.Trim();

        if (paths.Any(p => FileIndexer.PathHelper.AreSame(p.Path, trimmedPath)))
        {
            pathError = "Path already added.";
            return;
        }

        if (!Directory.Exists(trimmedPath))
        {
            pathError = "Directory does not exist.";
            return;
        }

        // Overlaps are only a warning: the path is added anyway.
        var collectionId = Collection?.Id ?? 0;
        overlaps = await CollectionService.CheckPathOverlapsAsync(collectionId, trimmedPath);

        paths.Add(new CollectionPath { Id = 0, CollectionId = collectionId, Path = trimmedPath });
        newPath = "";
    }

    private async Task OnPathKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddPath();
        }
    }

    private async Task Browse()
    {
        var picked = await dialogs.PickFolderAsync(string.IsNullOrWhiteSpace(newPath) ? null : newPath);
        if (picked != null)
        {
            newPath = picked;
            await AddPath();
        }
    }

    private void RemovePath(CollectionPath path)
    {
        if (path.Id > 0)
        {
            removedPathIds.Add(path.Id);
        }
        paths.Remove(path);
    }

    private async Task Save()
    {
        nameError = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            nameError = "Name is required.";
            return;
        }

        try
        {
            if (Collection == null)
            {
                await CollectionService.CreateAsync(name.Trim(), description?.Trim(), excludedDirectories.Trim(), paths.Select(p => p.Path));
            }
            else
            {
                await CollectionService.UpdateAsync(Collection.Id, name.Trim(), description?.Trim(), excludedDirectories.Trim());

                foreach (var pathId in removedPathIds)
                {
                    await CollectionService.RemovePathAsync(pathId);
                }

                foreach (var path in paths.Where(p => p.Id == 0))
                {
                    await CollectionService.AddPathAsync(Collection.Id, path.Path);
                }
            }

            await OnSave.InvokeAsync();
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex) when (ex.SqliteErrorCode == 19) // SQLITE_CONSTRAINT
        {
            nameError = "A collection with this name already exists.";
        }
        catch (Exception ex)
        {
            nameError = "Error saving collection: " + ex.Message;
        }
    }
}
