@inject CollectionService CollectionSvc
@inject ConfigExportService ConfigExportSvc
@inject IConfigFileExchange FileExchange
@inject UiFeedback Feedback
@inject IServiceProvider Services
@inject ILogger<CollectionsView> Logger
@implements IDisposable

<div class="view-container">
    <div class="collections-header">
        <div class="collections-header-actions">
            @if (fs != null)
            {
                <button class="btn-secondary" @onclick="ReindexAll" disabled="@IsScanning" title="Reindex all collections">Reindex all</button>
            }
            <button class="btn-secondary" @onclick="ExportConfig" title="Export configuration">Export</button>
            @if (fs != null)
            {
                <button class="btn-secondary" @onclick="ImportConfig" title="Import configuration">Import</button>
            }
        </div>
        @if (fs != null)
        {
            <button class="btn-primary" @onclick="() => OpenEditor(null)">+ New Collection</button>
        }
    </div>

    <div class="collections-content">
        @if (Collections == null)
        {
            <div class="loading">Loading...</div>
        }
        else if (Collections.Count == 0)
        {
            <div class="empty-state">
                <p>No collections yet. Create one to start organizing your indexed files.</p>
                @if (fs != null)
                {
                    <button class="btn-primary" @onclick="() => OpenEditor(null)">Create your first collection</button>
                }
            </div>
        }
        else
        {
            <div class="collection-grid">
                @foreach (var collection in Collections)
                {
                    var isScanningThis = ScanningCollectionId == collection.Id;
                    <div class="collection-card @(isScanningThis ? "scanning" : pendingReindexIds.Contains(collection.Id) ? "pending" : "")">
                        <div class="collection-header">
                            <h3>@collection.Name</h3>
                            @if (fs != null)
                            {
                                <div class="collection-actions">
                                    <button class="btn-icon-sm" @onclick="() => IndexAsync(collection)" disabled="@(IsScanning || collection.Paths.Count == 0)" title="Index">
                                        <span class="@(isScanningThis ? "icon-spin" : "")">🔄</span>
                                    </button>
                                    <button class="btn-icon-sm" @onclick="() => CleanEmptyFolders(collection)" disabled="@(collection.Paths.Count == 0)" title="Clean empty folders">🧹</button>
                                    <button class="btn-icon-sm" @onclick="() => OpenEditor(collection)" title="Edit">✏️</button>
                                    <button class="btn-icon-sm btn-danger-icon" @onclick="() => Delete(collection)" title="Delete">🗑️</button>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(collection.Description))
                        {
                            <p class="collection-description">@collection.Description</p>
                        }
                        <div class="collection-paths">
                            @if (collection.Paths.Count == 0)
                            {
                                <span class="no-paths">No paths configured</span>
                            }
                            @foreach (var p in collection.Paths)
                            {
                                <div class="path-item" title="@p.Path">📁 @UiFormat.TruncatePath(p.Path, 40)</div>
                            }
                        </div>
                        <div class="collection-stats">
                            @if (collection.FileCount > 0)
                            {
                                <span>📄 @collection.FileCount.ToString("N0") files</span>
                                @if (collection.LastIndexedAtUtc.HasValue)
                                {
                                    <span>⏱️ @UiFormat.RelativeTime(collection.LastIndexedAtUtc.Value)</span>
                                }
                            }
                            else
                            {
                                <span class="never-indexed">Never indexed</span>
                            }
                        </div>

                        @if (isScanningThis && progress != null)
                        {
                            <div class="scan-progress">
                                <div class="progress-bar-container">
                                    <div class="progress-bar" style="width: @(Math.Min(progress.ProgressPercent, 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <div class="progress-text">
                                    @progress.FilesScanned.ToString("N0") files | @UiFormat.Duration(progress.Elapsed)
                                </div>
                            </div>
                        }
                        else if (pendingReindexIds.Contains(collection.Id))
                        {
                            <div class="scan-progress pending">
                                <span class="pending-text">⏳ Pending reindex...</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showEditor)
{
    <CollectionEditor Collection="editingCollection" OnSave="OnEditorSave" OnCancel="CloseEditor" />
}

@if (importData != null)
{
    <Modal Title="Import Configuration" Size="modal-large" OnClose="() => importData = null">
        <p><strong>@importData.Collections.Count</strong> collection(s) found in file.</p>
        @if (importHasCollisions)
        {
            <p class="warning">⚠️ Some collection names already exist. Choose how to handle duplicates:</p>
            <div class="modal-actions" style="justify-content: flex-start; margin-top: 0.5rem; margin-bottom: 1rem;">
                <button class="@(importStrategy == ImportCollisionStrategy.Skip ? "btn-primary" : "btn-secondary")"
                        @onclick="() => importStrategy = ImportCollisionStrategy.Skip">Skip duplicates</button>
                <button class="@(importStrategy == ImportCollisionStrategy.Rename ? "btn-primary" : "btn-secondary")"
                        @onclick="() => importStrategy = ImportCollisionStrategy.Rename">Auto-rename</button>
            </div>
        }
        <div class="modal-actions">
            <button class="btn-secondary" @onclick="() => importData = null">Cancel</button>
            <button class="btn-primary" @onclick="DoImport">Import</button>
        </div>
    </Modal>
}

@if (importResult != null)
{
    <Modal Title="Import Complete" Size="modal-small" OnClose="() => importResult = null">
        <p><strong>@importResult.Imported</strong> imported, <strong>@importResult.Skipped</strong> skipped, <strong>@importResult.Renamed</strong> renamed.</p>
        @if (importResult.Details.Count > 0)
        {
            <ul class="detail-list">
                @foreach (var detail in importResult.Details)
                {
                    <li>@detail</li>
                }
            </ul>
        }
        <div class="modal-actions">
            <button class="btn-primary" @onclick="() => importResult = null">OK</button>
        </div>
    </Modal>
}

@if (cleanResult != null)
{
    <Modal Title="Empty Folders Cleaned" Size="modal-large" OnClose="() => cleanResult = null">
        <p><strong>@cleanResult.DeletedFolders.Count</strong> empty folder(s) deleted.</p>
        @if (cleanResult.ErrorCount > 0)
        {
            <p class="warning">⚠️ @cleanResult.ErrorCount error(s) encountered.</p>
        }
        @if (cleanResult.DeletedFolders.Count > 0)
        {
            <div class="scroll-list">
                <ul class="detail-list monospace">
                    @foreach (var folder in cleanResult.DeletedFolders)
                    {
                        <li>@folder</li>
                    }
                </ul>
            </div>
        }
        <div class="modal-actions">
            <button class="btn-primary" @onclick="() => cleanResult = null">OK</button>
        </div>
    </Modal>
}

@code {
    // Owned by the shell; null while loading. Changes are reported through OnCollectionsChanged
    // and come back as a new list.
    [Parameter] public List<Collection>? Collections { get; set; }
    [Parameter] public EventCallback OnCollectionsChanged { get; set; }

    // Null on hosts without file system access: collections are read-only there.
    private FileSystemFeatures? fs;

    private bool showEditor;
    private Collection? editingCollection;

    // The scanner is shared by every session: its state, not a local flag, says what is running.
    private ScanProgress? progress;
    private ScanProgress? lastFinished;
    private bool IsScanning => fs?.Scanner.IsRunning == true;
    private int? ScanningCollectionId => IsScanning ? progress?.CollectionId : null;
    private HashSet<int> pendingReindexIds = new();

    private ConfigExport? importData;
    private ImportResult? importResult;
    private ImportCollisionStrategy importStrategy = ImportCollisionStrategy.Skip;
    private bool importHasCollisions;

    private EmptyFolderCleanResult? cleanResult;

    protected override void OnInitialized()
    {
        fs = Services.GetService<FileSystemFeatures>();
        if (fs != null)
        {
            progress = fs.Scanner.CurrentProgress;
            if (!fs.Scanner.IsRunning) lastFinished = progress;
            fs.Scanner.OnProgressChanged += OnProgressChanged;
        }
    }

    // Raised from the scanner threads, possibly for a scan started by another session. The end
    // of any scan is the single trigger for reloading the collections' stats.
    // Each scan gets its own ScanProgress (mutated in place while it runs), so "a scan we have
    // not reported yet is no longer running" detects every end, even of very short scans.
    private void OnProgressChanged(ScanProgress p) => _ = InvokeAsync(async () =>
    {
        var finished = !p.IsRunning && !ReferenceEquals(p, lastFinished);
        if (finished) lastFinished = p;
        progress = p;
        StateHasChanged();
        if (finished)
        {
            await OnCollectionsChanged.InvokeAsync();
        }
    });

    private void OpenEditor(Collection? collection)
    {
        editingCollection = collection;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editingCollection = null;
    }

    private async Task OnEditorSave()
    {
        CloseEditor();
        await OnCollectionsChanged.InvokeAsync();
    }

    private async Task Delete(Collection collection)
    {
        var message = collection.FileCount > 0
            ? $"Delete \"{collection.Name}\" and its {collection.FileCount:N0} indexed entries? Files on disk are not touched."
            : $"Delete \"{collection.Name}\"?";
        if (!await Feedback.ConfirmAsync("Delete Collection", message, "Delete", danger: true)) return;

        try
        {
            await CollectionSvc.DeleteAsync(collection.Id);
            await OnCollectionsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete collection {Id}", collection.Id);
            await Feedback.ShowErrorAsync($"Cannot delete the collection: {ex.Message}");
        }
    }

    // One scan as an activity-log entry. The scan's end event refreshes the collections.
    private async Task<bool> ScanAsync(Collection collection)
    {
        ScanProgress? result = null;
        var outcome = await Feedback.RunOperationAsync($"Indexing \"{collection.Name}\"", async _ =>
            {
                result = await fs!.Scanner.ScanCollectionAsync(
                    collection.Id, collection.Paths.Select(p => p.Path), excludedDirectories: collection.GetExcludedDirectoryList());
                return OperationResult.Success();
            },
            () => $"\"{collection.Name}\": {result!.FilesScanned:N0} entries, {result.FilesRemoved:N0} removed in {UiFormat.Duration(result.Elapsed)}");
        return outcome.IsSuccess;
    }

    private async Task IndexAsync(Collection collection)
    {
        if (!IsScanning && collection.Paths.Count > 0)
        {
            await ScanAsync(collection);
        }
    }

    private async Task ReindexAll()
    {
        if (IsScanning || Collections == null) return;

        var indexable = Collections.Where(c => c.Paths.Count > 0).ToList();
        pendingReindexIds = indexable.Select(c => c.Id).ToHashSet();
        try
        {
            foreach (var collection in indexable)
            {
                pendingReindexIds.Remove(collection.Id);
                if (!await ScanAsync(collection)) return;
            }
        }
        finally
        {
            pendingReindexIds.Clear();
        }
    }

    private async Task CleanEmptyFolders(Collection collection)
    {
        EmptyFolderCleanResult? result = null;
        var outcome = await Feedback.RunOperationAsync($"Cleaning empty folders in \"{collection.Name}\"", async _ =>
            {
                result = await fs!.Files.CleanEmptyFoldersAsync(collection.Paths.Select(p => p.Path));
                return OperationResult.Success();
            },
            () => result!.DeletedFolders.Count == 0 ? "No empty folders found" : $"{UiFormat.Count(result.DeletedFolders.Count, "empty folder")} deleted");

        if (outcome.IsSuccess && (result!.DeletedFolders.Count > 0 || result.ErrorCount > 0))
        {
            cleanResult = result;
            await OnCollectionsChanged.InvokeAsync();
        }
    }

    private async Task ExportConfig()
    {
        try
        {
            var export = await ConfigExportSvc.BuildExportAsync();
            var fileName = $"fileindexer-config-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            if (await FileExchange.SaveAsync(fileName, ConfigExportSvc.Serialize(export)))
            {
                Feedback.ShowToast("Configuration exported");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Export failed");
            Feedback.ShowToast($"Export failed: {ex.Message}", error: true);
        }
    }

    private async Task ImportConfig()
    {
        try
        {
            var json = await FileExchange.OpenTextAsync();
            if (json == null) return;

            var data = ConfigExportSvc.Deserialize(json);
            if (data == null || data.Collections.Count == 0)
            {
                Feedback.ShowToast("No collections found in file.", error: true);
                return;
            }

            importHasCollisions = await ConfigExportSvc.HasCollisionsAsync(data);
            importStrategy = ImportCollisionStrategy.Skip;
            importData = data;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Import file could not be read");
            Feedback.ShowToast($"Import failed: {ex.Message}", error: true);
        }
    }

    private async Task DoImport()
    {
        var data = importData;
        importData = null;
        if (data == null) return;

        try
        {
            importResult = await ConfigExportSvc.ImportCollectionsAsync(data, importStrategy);
            await OnCollectionsChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Import failed");
            await Feedback.ShowErrorAsync($"Import failed: {ex.Message}");
        }
    }

    public void Dispose()
    {
        if (fs != null)
            fs.Scanner.OnProgressChanged -= OnProgressChanged;
    }
}
