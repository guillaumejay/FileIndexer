@inject IServiceProvider Services
@implements IDisposable

@if (activityLog != null)
{
    <div class="activity-indicator" @onclick="TogglePanel" @onclick:stopPropagation>
        @if (runningCount > 0)
        {
            <span class="activity-badge running" title="@runningCount running">
                <span class="activity-spinner"></span> @runningCount
            </span>
        }
        else
        {
            <span class="activity-badge idle" title="Activity log">&#x1f4cb;</span>
        }
    </div>

    @if (showPanel)
    {
        <div class="activity-overlay" @onclick="() => showPanel = false"></div>
        <div class="activity-panel">
            <div class="activity-panel-header">
                <span>Activity Log</span>
                <button class="modal-close" @onclick="() => showPanel = false">&#x2715;</button>
            </div>
            <div class="activity-panel-body">
                @if (entries.Count == 0)
                {
                    <div class="activity-empty">No recent activity</div>
                }
                @foreach (var entry in entries)
                {
                    <div class="activity-entry @entry.Status.ToString().ToLowerInvariant()">
                        <span class="activity-icon">
                            @switch (entry.Status)
                            {
                                case ActivityStatus.Running:
                                    <span class="activity-spinner-sm"></span>
                                    break;
                                case ActivityStatus.Success:
                                    <text>&#x2705;</text>
                                    break;
                                case ActivityStatus.Error:
                                    <text>&#x274c;</text>
                                    break;
                            }
                        </span>
                        <span class="activity-desc">
                            @entry.Description
                            @if (entry.Status == ActivityStatus.Running && entry.ProgressText is not null)
                            {
                                <span class="activity-progress">@entry.ProgressText@(entry.CurrentItem is not null ? $" — {entry.CurrentItem}" : "")</span>
                            }
                            @if (entry.Duration.HasValue)
                            {
                                <span class="activity-duration">@UiFormat.Duration(entry.Duration.Value)</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.ResultMessage))
                            {
                                <span class="activity-result">@entry.ResultMessage</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.ErrorMessage))
                            {
                                <span class="activity-error">@entry.ErrorMessage</span>
                            }
                        </span>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    // Null on hosts without file system access: there is nothing to log there.
    private ActivityLogService? activityLog;
    private bool showPanel;
    private int runningCount;
    private List<ActivityEntry> entries = new();

    protected override void OnInitialized()
    {
        activityLog = Services.GetService<FileSystemFeatures>()?.ActivityLog;
        if (activityLog == null) return;

        activityLog.OnChanged += OnActivityChanged;
        Refresh();
    }

    // Raised from whatever thread ran the operation.
    private void OnActivityChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        entries = activityLog!.Entries.ToList();
        runningCount = activityLog.RunningCount;
    }

    private void TogglePanel()
    {
        showPanel = !showPanel;
        if (showPanel) Refresh();
    }

    public void Dispose()
    {
        if (activityLog != null)
            activityLog.OnChanged -= OnActivityChanged;
    }
}
