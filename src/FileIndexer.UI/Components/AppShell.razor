@inject CollectionService CollectionSvc
@inject BuildInfoService BuildInfo
@inject FileIndexerJs Js
@inject UiFeedback Feedback
@inject ILogger<AppShell> Logger

<div class="page-container">
    <header class="app-header-bar">
        <div class="header-row">
            <h1 class="app-title">File Indexer</h1>
            <div class="tab-nav">
                <button class="tab-btn @(activeTab == Tab.Search ? "active" : "")" @onclick="() => SetTab(Tab.Search)">🔍 Search</button>
                <button class="tab-btn @(activeTab == Tab.Collections ? "active" : "")" @onclick="() => SetTab(Tab.Collections)">📁 Collections</button>
            </div>
            <div class="header-buttons">
                <ActivityIndicator />
                <button class="btn-icon" @onclick="ToggleTheme" title="Toggle theme">@(isLightTheme ? "🌙" : "☀️")</button>
                <button class="btn-icon" @onclick="() => showSettings = true" title="Settings">⚙️</button>
            </div>
        </div>
    </header>

    <div class="tab-content">
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @if (activeTab == Tab.Search)
                {
                    <SearchView Collections="collections ?? new()" />
                }
                else
                {
                    <CollectionsView Collections="collections" OnCollectionsChanged="LoadCollections" />
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="error-panel">
                    <h2>Something went wrong</h2>
                    <pre>@ex.Message</pre>
                    <button class="btn-primary" @onclick="() => errorBoundary?.Recover()">Retry</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</div>

@if (showSettings)
{
    <Modal Title="Settings" Size="modal-small" OnClose="() => showSettings = false">
        @SettingsContent
        <div class="settings-group">
            <label class="settings-label">Application</label>
            <div class="settings-info">
                <div>Version: <strong>@BuildInfo.Version</strong></div>
                <div>Build date: <strong>@BuildInfo.BuildDate.ToLocalTime().ToString("g")</strong></div>
            </div>
        </div>
        <div class="modal-actions">
            <button class="btn-primary" @onclick="() => showSettings = false">Close</button>
        </div>
    </Modal>
}

@* Rendered last so they stack above every view and modal. *@
<Dialogs />
<Toast />

@code {
    // Host-specific settings (e.g. database selection on MAUI), shown above the app info.
    [Parameter] public RenderFragment? SettingsContent { get; set; }

    private enum Tab { Search, Collections }

    private Tab activeTab = Tab.Search;
    private bool isLightTheme;
    private bool showSettings;
    // The one copy of the collection list, handed to both views (null while loading).
    private List<Collection>? collections;
    private ErrorBoundary? errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLightTheme = await Js.IsLightThemeAsync();
            StateHasChanged();
        }
    }

    private async Task LoadCollections()
    {
        try
        {
            collections = await CollectionSvc.GetAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load collections");
            collections = new();
            Feedback.ShowToast($"Cannot load collections: {ex.Message}", error: true);
        }
    }

    private void SetTab(Tab tab)
    {
        activeTab = tab;
        errorBoundary?.Recover();
    }

    private async Task ToggleTheme()
    {
        isLightTheme = !isLightTheme;
        await Js.SetLightThemeAsync(isLightTheme);
    }
}
