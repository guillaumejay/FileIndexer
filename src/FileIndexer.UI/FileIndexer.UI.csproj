<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Blazor components shared by the Web (Blazor Server) and MAUI (Blazor Hybrid) hosts. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileIndexer.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileIndexer.Core\FileIndexer.Core.csproj" />
    <ProjectReference Include="..\FileIndexer.Desktop\FileIndexer.Desktop.csproj" />
  </ItemGroup>

</Project>
