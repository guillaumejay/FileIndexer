@inject CollectionService CollectionSvc
@inject ConfigExportService ConfigExportSvc
@inject AppSettings Settings
@inject IJSRuntime JS
@inject FileScannerService Scanner
@inject FileOperationsService FileOps
@inject ActivityLogService ActivityLog
@implements IDisposable

<div class="view-container">
    <div class="collections-header">
        <div class="collections-header-actions">
            <button class="btn-secondary" @onclick="ReindexAll" disabled="@isScanning" title="R&eacute;indexer toutes les collections">Tout r&eacute;indexer</button>
            <button class="btn-secondary" @onclick="ExportConfig" title="Export configuration">Export</button>
            <label class="btn-secondary" style="cursor: pointer; display: inline-flex; align-items: center;">
                Import
                <InputFile OnChange="OnImportFileSelected" accept=".json" style="display: none;" />
            </label>
        </div>
        <button class="btn-primary" @onclick="() => OpenEditor(null)">+ New Collection</button>
    </div>

    <div class="collections-content">
        @if (collections == null)
        {
            <div class="loading">Loading...</div>
        }
        else if (collections.Count == 0)
        {
            <div class="empty-state">
                <p>No collections yet. Create one to start organizing your indexed files.</p>
                <button class="btn-primary" @onclick="() => OpenEditor(null)">Create your first collection</button>
            </div>
        }
        else
        {
            <div class="collection-grid">
                @foreach (var collection in collections)
                {
                    <div class="collection-card @(scanningCollectionId == collection.Id ? "scanning" : pendingReindexIds.Contains(collection.Id) ? "pending" : "")">
                        <div class="collection-header">
                            <h3>@collection.Name</h3>
                            <div class="collection-actions">
                                <button class="btn-icon-sm" @onclick="() => StartIndexing(collection)" disabled="@(isScanning || collection.Paths.Count == 0)" title="Index">
                                    <span class="@(scanningCollectionId == collection.Id ? "icon-spin" : "")">🔄</span>
                                </button>
                                <button class="btn-icon-sm" @onclick="() => StartCleanEmptyFolders(collection)" disabled="@(collection.Paths.Count == 0)" title="Clean empty folders">
                                    🧹
                                </button>
                                <button class="btn-icon-sm" @onclick="() => OpenEditor(collection)" title="Edit">
                                    ✏️
                                </button>
                                <button class="btn-icon-sm btn-danger-icon" @onclick="() => ConfirmDelete(collection)" title="Delete">
                                    🗑️
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(collection.Description))
                        {
                            <p class="collection-description">@collection.Description</p>
                        }
                        <div class="collection-paths">
                            @if (collection.Paths.Count == 0)
                            {
                                <span class="no-paths">No paths configured</span>
                            }
                            else
                            {
                                @foreach (var p in collection.Paths)
                                {
                                    <div class="path-item" title="@p.Path">📁 @TruncatePath(p.Path, 40)</div>
                                }
                            }
                        </div>
                        <div class="collection-stats">
                            @if (collection.FileCount > 0)
                            {
                                <span>📄 @collection.FileCount.ToString("N0") files</span>
                                @if (collection.LastIndexedAtUtc.HasValue)
                                {
                                    <span>⏱️ @FormatRelativeTime(collection.LastIndexedAtUtc.Value)</span>
                                }
                            }
                            else
                            {
                                <span class="never-indexed">Never indexed</span>
                            }
                        </div>

                        @if (scanningCollectionId == collection.Id && progress != null)
                        {
                            <div class="scan-progress">
                                <div class="progress-bar-container">
                                    <div class="progress-bar" style="width: @(Math.Min(progress.ProgressPercent, 100))%"></div>
                                </div>
                                <div class="progress-text">
                                    @progress.FilesScanned.ToString("N0") files | @progress.Elapsed.ToString(@"mm\:ss")
                                    @if (progress.IsComplete)
                                    {
                                        <span class="success">✅</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (pendingReindexIds.Contains(collection.Id))
                        {
                            <div class="scan-progress pending">
                                <span class="pending-text">⏳ En attente de r&eacute;indexation...</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showEditor)
{
    <CollectionEditor
        Collection="editingCollection"
        OnSave="OnEditorSave"
        OnCancel="CloseEditor"
        CollectionService="CollectionSvc" />
}

@if (showDeleteConfirm && deletingCollection != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Delete Collection</h2>
                <button class="modal-close" @onclick="CancelDelete">✕</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete "<strong>@deletingCollection.Name</strong>"?</p>
                @if (deletingCollection.FileCount > 0)
                {
                    <p class="warning">⚠️ This will also delete @deletingCollection.FileCount.ToString("N0") indexed files.</p>
                }
                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn-danger" @onclick="DoDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@* Import Preview Dialog *@
@if (showImportPreview && importData != null)
{
    <div class="modal-overlay" @onclick="CancelImport">
        <div class="modal-content modal-large" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Import Configuration</h2>
                <button class="modal-close" @onclick="CancelImport">✕</button>
            </div>
            <div class="modal-body">
                <p><strong>@importData.Collections.Count</strong> collection(s) found in file.</p>
                @if (importData.Settings != null)
                {
                    <p>Settings included (will be applied on import).</p>
                }

                @if (importHasCollisions)
                {
                    <p class="warning">⚠️ Some collection names already exist. Choose how to handle duplicates:</p>
                    <div class="modal-actions" style="justify-content: flex-start; margin-top: 0.5rem; margin-bottom: 1rem;">
                        <button class="@(importStrategy == ImportCollisionStrategy.Skip ? "btn-primary" : "btn-secondary")"
                                @onclick="() => importStrategy = ImportCollisionStrategy.Skip">
                            Skip duplicates
                        </button>
                        <button class="@(importStrategy == ImportCollisionStrategy.Rename ? "btn-primary" : "btn-secondary")"
                                @onclick="() => importStrategy = ImportCollisionStrategy.Rename">
                            Auto-rename
                        </button>
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CancelImport">Cancel</button>
                    <button class="btn-primary" @onclick="DoImport">Import</button>
                </div>
            </div>
        </div>
    </div>
}

@* Import Result Dialog *@
@if (showImportResult && importResult != null)
{
    <div class="modal-overlay" @onclick="CloseImportResult">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Import Complete</h2>
                <button class="modal-close" @onclick="CloseImportResult">✕</button>
            </div>
            <div class="modal-body">
                <p><strong>@importResult.Imported</strong> imported, <strong>@importResult.Skipped</strong> skipped, <strong>@importResult.Renamed</strong> renamed.</p>
                @if (importResult.Details.Count > 0)
                {
                    <ul style="font-size: 0.8125rem; color: var(--text-secondary); padding-left: 1.25rem;">
                        @foreach (var detail in importResult.Details)
                        {
                            <li>@detail</li>
                        }
                    </ul>
                }
                <div class="modal-actions">
                    <button class="btn-primary" @onclick="CloseImportResult">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@* Clean Empty Folders Result Dialog *@
@if (showCleanResult && cleanResult != null)
{
    <div class="modal-overlay" @onclick="CloseCleanResult">
        <div class="modal-content modal-large" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Empty Folders Cleaned</h2>
                <button class="modal-close" @onclick="CloseCleanResult">&#x2715;</button>
            </div>
            <div class="modal-body">
                <p><strong>@cleanResult.DeletedFolders.Count</strong> empty folder(s) deleted.</p>
                @if (cleanResult.ErrorCount > 0)
                {
                    <p class="warning">&#x26a0;&#xfe0f; @cleanResult.ErrorCount error(s) encountered.</p>
                }
                @if (cleanResult.DeletedFolders.Count > 0)
                {
                    <div style="max-height: 300px; overflow-y: auto; margin-top: 0.75rem;">
                        <ul style="font-size: 0.8125rem; color: var(--text-secondary); padding-left: 1.25rem; font-family: monospace;">
                            @foreach (var folder in cleanResult.DeletedFolders)
                            {
                                <li>@folder</li>
                            }
                        </ul>
                    </div>
                }
                <div class="modal-actions">
                    <button class="btn-primary" @onclick="CloseCleanResult">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCollectionsChanged { get; set; }

    private List<Collection>? collections;
    private bool showEditor = false;
    private Collection? editingCollection;
    private bool showDeleteConfirm = false;
    private Collection? deletingCollection;
    private bool isScanning = false;
    private int? scanningCollectionId;
    private ScanProgress? progress;
    private HashSet<int> pendingReindexIds = new();

    // Import state
    private bool showImportPreview;
    private bool showImportResult;
    private ConfigExport? importData;
    private ImportResult? importResult;
    private ImportCollisionStrategy importStrategy = ImportCollisionStrategy.Skip;
    private bool importHasCollisions;

    // Clean empty folders state
    private bool showCleanResult;
    private EmptyFolderCleanResult? cleanResult;

    protected override async Task OnInitializedAsync()
    {
        Scanner.OnProgressChanged += OnProgressChanged;
        await LoadCollections();
    }

    public async Task RefreshCollections()
    {
        await LoadCollections();
    }

    private async Task LoadCollections()
    {
        collections = await CollectionSvc.GetAllAsync();
    }

    private void OpenEditor(Collection? collection)
    {
        editingCollection = collection;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editingCollection = null;
    }

    private async Task OnEditorSave()
    {
        CloseEditor();
        await LoadCollections();
        await OnCollectionsChanged.InvokeAsync();
    }

    private void ConfirmDelete(Collection collection)
    {
        deletingCollection = collection;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deletingCollection = null;
    }

    private async Task DoDelete()
    {
        if (deletingCollection != null)
        {
            await CollectionSvc.DeleteAsync(deletingCollection.Id);
            await LoadCollections();
            await OnCollectionsChanged.InvokeAsync();
        }
        CancelDelete();
    }

    private async Task StartIndexing(Collection collection)
    {
        if (isScanning || collection.Paths.Count == 0) return;

        isScanning = true;
        scanningCollectionId = collection.Id;
        progress = new ScanProgress { IsRunning = true };
        var activity = ActivityLog.StartActivity($"Indexing \"{collection.Name}\"");

        try
        {
            var paths = collection.Paths.Select(p => p.Path);
            var result = await Scanner.ScanCollectionAsync(collection.Id, paths, excludedDirectories: collection.GetExcludedDirectoryList());
            ActivityLog.CompleteActivity(activity.Id, $"{result.FilesScanned:N0} files indexed in {result.Elapsed.TotalSeconds:F1}s");
            await LoadCollections();
            await OnCollectionsChanged.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
            ActivityLog.FailActivity(activity.Id, "Cancelled");
        }
        catch (Exception ex)
        {
            ActivityLog.FailActivity(activity.Id, ex.Message);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isScanning = false;
            scanningCollectionId = null;
        }
    }

    private async Task ReindexAll()
    {
        if (isScanning || collections == null) return;

        var indexable = collections.Where(c => c.Paths.Count > 0).ToList();
        if (indexable.Count == 0) return;

        isScanning = true;
        pendingReindexIds = new HashSet<int>(indexable.Select(c => c.Id));
        StateHasChanged();

        var activity = ActivityLog.StartActivity($"Reindexing all ({indexable.Count} collections)");
        var totalFiles = 0;

        try
        {
            foreach (var collection in indexable)
            {
                pendingReindexIds.Remove(collection.Id);
                scanningCollectionId = collection.Id;
                progress = new ScanProgress { IsRunning = true };
                StateHasChanged();

                var paths = collection.Paths.Select(p => p.Path);
                var result = await Scanner.ScanCollectionAsync(collection.Id, paths, excludedDirectories: collection.GetExcludedDirectoryList());
                totalFiles += result.FilesScanned;
            }

            ActivityLog.CompleteActivity(activity.Id, $"{totalFiles:N0} files indexed across {indexable.Count} collections");
            await LoadCollections();
            await OnCollectionsChanged.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
            ActivityLog.FailActivity(activity.Id, "Cancelled");
        }
        catch (Exception ex)
        {
            ActivityLog.FailActivity(activity.Id, ex.Message);
            Console.Error.WriteLine(ex);
        }
        finally
        {
            isScanning = false;
            scanningCollectionId = null;
            pendingReindexIds.Clear();
        }
    }

    private void OnProgressChanged(ScanProgress p)
    {
        progress = p;
        InvokeAsync(StateHasChanged);
    }

    // Clean empty folders
    private async Task StartCleanEmptyFolders(Collection collection)
    {
        if (collection.Paths.Count == 0) return;

        var activity = ActivityLog.StartActivity($"Cleaning empty folders in \"{collection.Name}\"");

        try
        {
            var paths = collection.Paths.Select(p => p.Path);
            cleanResult = await FileOps.CleanEmptyFoldersAsync(paths);

            if (cleanResult.DeletedFolders.Count > 0 || cleanResult.ErrorCount > 0)
            {
                showCleanResult = true;
            }

            ActivityLog.CompleteActivity(activity.Id);
        }
        catch (Exception ex)
        {
            ActivityLog.FailActivity(activity.Id, ex.Message);
        }

        StateHasChanged();
    }

    private void CloseCleanResult()
    {
        showCleanResult = false;
        cleanResult = null;
    }

    // Export / Import
    private async Task ExportConfig()
    {
        var exportedSettings = new ExportedSettings
        {
            DefaultScanPath = Settings.DefaultScanPath,
            ScanParallelism = Settings.ScanParallelism,
            ScanBatchSize = Settings.ScanBatchSize
        };

        var export = await ConfigExportSvc.BuildExportAsync(exportedSettings);
        var json = ConfigExportSvc.Serialize(export);
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        var fileName = $"fileindexer-config-{DateTime.Now:yyyyMMdd-HHmmss}.json";

        await JS.InvokeVoidAsync("downloadFile", fileName, "application/json", bytes);
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            importData = ConfigExportSvc.Deserialize(json);
            if (importData == null || importData.Collections.Count == 0)
            {
                return;
            }

            // Check for collisions
            var existingNames = (collections ?? new()).Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            importHasCollisions = importData.Collections.Any(c => existingNames.Contains(c.Name));
            importStrategy = ImportCollisionStrategy.Skip;
            showImportPreview = true;
        }
        catch
        {
            // Invalid file
        }
    }

    private void CancelImport()
    {
        showImportPreview = false;
        importData = null;
    }

    private async Task DoImport()
    {
        if (importData == null) return;

        showImportPreview = false;

        importResult = await ConfigExportSvc.ImportCollectionsAsync(importData, importStrategy);

        // Apply settings if present
        if (importData.Settings != null)
        {
            Settings.DefaultScanPath = importData.Settings.DefaultScanPath;
            Settings.ScanParallelism = importData.Settings.ScanParallelism;
            Settings.ScanBatchSize = importData.Settings.ScanBatchSize;
        }

        await LoadCollections();
        await OnCollectionsChanged.InvokeAsync();

        importData = null;
        showImportResult = true;
    }

    private void CloseImportResult()
    {
        showImportResult = false;
        importResult = null;
    }

    private static string TruncatePath(string path, int maxLength)
    {
        if (string.IsNullOrEmpty(path) || path.Length <= maxLength)
            return path;
        return path[..(maxLength - 3)] + "...";
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var elapsed = DateTime.UtcNow - utcTime;
        if (elapsed.TotalMinutes < 1) return "just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h ago";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    public void Dispose()
    {
        Scanner.OnProgressChanged -= OnProgressChanged;
    }
}
