@page "/"
@inject CollectionService CollectionSvc
@inject BuildInfoService BuildInfo
@inject IJSRuntime JS
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer

<div class="page-container">
    <header class="app-header-bar">
        <div class="header-row">
            <h1 class="app-title">File Indexer</h1>
            <div class="tab-nav">
                <button class="tab-btn @(activeTab == "search" ? "active" : "")" @onclick='() => SetTab("search")'>
                    🔍 Search
                </button>
                <button class="tab-btn @(activeTab == "collections" ? "active" : "")" @onclick='() => SetTab("collections")'>
                    📁 Collections
                </button>
            </div>
            <div class="header-buttons">
                <ActivityIndicator />
                <button class="btn-icon" @onclick="ToggleTheme" title="Toggle theme">
                    @(isLightTheme ? "🌙" : "☀️")
                </button>
                <button class="btn-icon" @onclick="() => showSettings = true" title="Settings">
                    ⚙️
                </button>
            </div>
        </div>
    </header>

    <div class="tab-content">
        @if (activeTab == "search")
        {
            <SearchView @ref="searchViewRef" AvailableCollections="collections" OnCollectionsChanged="OnCollectionsChanged" />
        }
        else
        {
            <CollectionsView @ref="collectionsViewRef" OnCollectionsChanged="OnCollectionsChanged" />
        }
    </div>
</div>

@if (showSettings)
{
    <div class="modal-overlay" @onclick="() => showSettings = false">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Settings</h2>
                <button class="modal-close" @onclick="() => showSettings = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="settings-group">
                    <label style="font-weight: 600; display: block; margin-bottom: 0.5rem; color: var(--text-primary);">Application</label>
                    <div style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6;">
                        <div>Version: <strong>@BuildInfo.Version</strong></div>
                        <div>Build date: <strong>@BuildInfo.BuildDate.ToLocalTime().ToString("g")</strong></div>
                    </div>
                </div>
                <div class="modal-actions" style="margin-top: 1.5rem;">
                    <button class="btn-primary" @onclick="() => showSettings = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "search";
    private bool isLightTheme = false;
    private bool showSettings = false;
    private List<Collection> collections = new();

    private SearchView? searchViewRef;
    private CollectionsView? collectionsViewRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTheme();
            StateHasChanged();
        }
    }

    private async Task LoadCollections()
    {
        collections = await CollectionSvc.GetAllAsync();
    }

    private async Task OnCollectionsChanged()
    {
        await LoadCollections();
        if (searchViewRef != null)
        {
            await searchViewRef.RefreshData();
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task LoadTheme()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("localStorage.getItem", "theme");
            isLightTheme = theme == "light";
            if (isLightTheme)
            {
                await JS.InvokeVoidAsync("eval", "document.body.classList.add('light-theme')");
            }
            else
            {
                await JS.InvokeVoidAsync("eval", "document.body.classList.remove('light-theme')");
            }
        }
        catch
        {
            // Ignore errors during prerendering
        }
    }

    private async Task ToggleTheme()
    {
        isLightTheme = !isLightTheme;
        var theme = isLightTheme ? "light" : "dark";
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", theme);
        if (isLightTheme)
        {
            await JS.InvokeVoidAsync("eval", "document.body.classList.add('light-theme')");
        }
        else
        {
            await JS.InvokeVoidAsync("eval", "document.body.classList.remove('light-theme')");
        }
    }
}
