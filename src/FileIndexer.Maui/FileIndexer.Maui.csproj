<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Base framework for all -->
    <TargetFrameworks Condition="'$(OnlyWindows)' != 'true'">net10.0-android</TargetFrameworks>
    <!-- iOS and MacCatalyst are only built on macOS -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(OnlyWindows)' != 'true'">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <!-- Windows only built on Windows -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) Or '$(OnlyWindows)' == 'true'">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    
    <!-- Clean up leading semicolon if it exists -->
    <TargetFrameworks Condition="$(TargetFrameworks.StartsWith(';'))">$(TargetFrameworks.Substring(1))</TargetFrameworks>
    
    <OutputType>Exe</OutputType>
    <RootNamespace>FileIndexer.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <!-- Define DESKTOP constant for Windows and macOS -->
    <DefineConstants Condition="$(TargetFramework.Contains('windows')) Or $(TargetFramework.Contains('maccatalyst'))">$(DefineConstants);DESKTOP</DefineConstants>

    <!-- Display name -->
    <ApplicationTitle>FileIndexer</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.fileindexer.app</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563eb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileIndexer.Core\FileIndexer.Core.csproj" />
  </ItemGroup>

  <!-- Desktop-only: reference FileIndexer.Desktop for full features on Windows/macOS -->
  <ItemGroup Condition="$(TargetFramework.Contains('windows')) Or $(TargetFramework.Contains('maccatalyst'))">
    <ProjectReference Include="..\FileIndexer.Desktop\FileIndexer.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.71" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.71" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
  </ItemGroup>

</Project>
