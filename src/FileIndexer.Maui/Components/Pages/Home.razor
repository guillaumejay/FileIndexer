@page "/"
@using FileIndexer.Models
@inject SearchService Search
@inject CollectionService Collections
@inject BuildInfoService BuildInfo
@inject DatabasePathService DbPathService
@inject IMauiFolderPickerService FolderPicker
@inject IJSRuntime JS

<div class="page-container">
    @* Header with tabs and actions *@
    <div class="search-header">
        <div class="tab-nav">
            <button class="tab-btn @(activeTab == "search" ? "active" : "")" @onclick='() => SetTab("search")'>
                🔍 Search
            </button>
            <button class="tab-btn @(activeTab == "collections" ? "active" : "")" @onclick='() => SetTab("collections")'>
                📁 Collections
            </button>
        </div>
        <div style="flex: 1;"></div>
        <ActivityIndicator />
        <button class="btn-icon" @onclick="ToggleTheme" title="Toggle theme">
            @(isLightTheme ? "🌙" : "☀️")
        </button>
        <button class="btn-icon" @onclick="OpenSettings" title="Settings">
            ⚙️
        </button>
    </div>

    @* Tab content *@
    @if (activeTab == "search")
    {
        @* Search input *@
        <div class="search-bar">
            <div class="search-wrapper">
                <input type="text"
                       class="search-input"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="OnSearchKeyUp"
                       placeholder="Search files..." />
            </div>
        </div>

        @* Filters *@
        <div class="collection-filter">
            <label class="filter-chip @(fileTypeFilter == FileTypeFilter.All ? "selected" : "")">
                <input type="radio" name="typeFilter" checked="@(fileTypeFilter == FileTypeFilter.All)"
                       @onchange="() => SetTypeFilter(FileTypeFilter.All)" />
                Tout
            </label>
            <label class="filter-chip @(fileTypeFilter == FileTypeFilter.Archives ? "selected" : "")">
                <input type="radio" name="typeFilter" checked="@(fileTypeFilter == FileTypeFilter.Archives)"
                       @onchange="() => SetTypeFilter(FileTypeFilter.Archives)" />
                Archives
            </label>
            <span class="filter-separator">|</span>
            <label class="filter-chip @(showFolders ? "selected" : "")">
                <input type="checkbox" checked="@showFolders"
                       @onchange="ToggleShowFolders" />
                Dossiers
            </label>
            @if (availableCollections.Count > 1)
            {
                <span class="filter-separator">|</span>
                @foreach (var col in availableCollections)
                {
                    <label class="filter-chip @(selectedCollectionIds.Contains(col.Id) ? "selected" : "")">
                        <input type="checkbox"
                               checked="@selectedCollectionIds.Contains(col.Id)"
                               @onchange="() => ToggleCollection(col.Id)" />
                        @col.Name
                    </label>
                }
            }
        </div>

        @* File list *@
        <div class="file-list-container">
            <table class="file-list-table">
                <thead>
                    <tr>
                        <th class="@(sortColumn == SortColumn.Name ? "sorted" : "")" @onclick="() => SetSort(SortColumn.Name)">
                            Name <span class="sort-indicator">@(sortColumn == SortColumn.Name ? (sortAsc ? "▲" : "▼") : "")</span>
                        </th>
                        <th class="@(sortColumn == SortColumn.Directory ? "sorted" : "")" @onclick="() => SetSort(SortColumn.Directory)">
                            Directory <span class="sort-indicator">@(sortColumn == SortColumn.Directory ? (sortAsc ? "▲" : "▼") : "")</span>
                        </th>
                        <th class="@(sortColumn == SortColumn.Extension ? "sorted" : "")" @onclick="() => SetSort(SortColumn.Extension)">
                            Ext <span class="sort-indicator">@(sortColumn == SortColumn.Extension ? (sortAsc ? "▲" : "▼") : "")</span>
                        </th>
                        <th class="@(sortColumn == SortColumn.Size ? "sorted" : "")" @onclick="() => SetSort(SortColumn.Size)">
                            Size <span class="sort-indicator">@(sortColumn == SortColumn.Size ? (sortAsc ? "▲" : "▼") : "")</span>
                        </th>
                        <th class="@(sortColumn == SortColumn.ModifiedAt ? "sorted" : "")" @onclick="() => SetSort(SortColumn.ModifiedAt)">
                            Modified <span class="sort-indicator">@(sortColumn == SortColumn.ModifiedAt ? (sortAsc ? "▲" : "▼") : "")</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize @ref="virtualizeRef" ItemsProvider="LoadFilesAsync" ItemSize="30" OverscanCount="20">
                        <ItemContent>
                            @{
                                var file = context;
                                var isSelected = selectedFileIds.Contains(file.Id);
                            }
                            <tr class="@(isSelected ? "selected" : "")"
                                @onclick="e => OnRowClick(e, file)"
                                @onclick:stopPropagation
                                @oncontextmenu="e => OnRowContextMenu(e, file)"
                                @oncontextmenu:preventDefault
                                @ondblclick="() => OnRowDoubleClick(file)">
                                <td class="file-name">@(file.IsDirectory ? "📁 " : "")@file.Name</td>
                                <td class="file-dir" title="@file.Directory">@file.Directory</td>
                                <td class="file-ext">@file.Extension</td>
                                <td class="file-size">@file.SizeFormatted</td>
                                <td class="file-date">@file.ModifiedAtUtc.ToLocalTime().ToString("g")</td>
                            </tr>
                        </ItemContent>
                        <Placeholder>
                            <tr>
                                <td colspan="5" style="color: var(--text-secondary);">Loading...</td>
                            </tr>
                        </Placeholder>
                    </Virtualize>
                </tbody>
            </table>
        </div>

        @* Stats bar *@
        <div class="stats-row">
            <span>📋 @totalCount.ToString("N0") files</span>
            @if (selectedFileIds.Count > 0)
            {
                <span class="stats-divider">|</span>
                <span class="selection-count">✓ @selectedFileIds.Count selected</span>
            }
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <span class="stats-divider">|</span>
                <span>🔍 "@searchQuery"</span>
            }
        </div>

        @if (!IsDesktop)
        {
            <div class="long-press-hint">
                Long-press a row to copy the file path
            </div>
        }
    }
    else
    {
        <CollectionsView @ref="collectionsViewRef" OnCollectionsChanged="OnCollectionsChanged" />
    }
</div>

@* Context menu (desktop only) *@
@if (IsDesktop && contextMenuVisible)
{
    <div class="context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;" @onclick:stopPropagation>
        @if (selectedFileIds.Count == 1)
        {
            <div class="context-menu-item" @onclick="OpenSelectedFile">Open</div>
            <div class="context-menu-item" @onclick="OpenSelectedFolder">Open Folder</div>
            <div class="context-menu-item" @onclick="FilterByFolder">Select this folder</div>
            <div class="context-menu-item" @onclick="StartRename">Rename</div>
        }
        @if (IsSelectedFileArchive())
        {
            <div class="context-menu-item" @onclick="StartExtract">Extract</div>
            <div class="context-menu-item" @onclick="StartExtractAndDelete">Extract &amp; delete archive</div>
        }
        <div class="context-menu-item" @onclick="CopySelectedPaths">Copy Path</div>
        @if (selectedFileIds.Count > 0)
        {
            <div class="context-menu-item" @onclick="StartCopy">Copy to...</div>
            <div class="context-menu-item" @onclick="StartMove">Move to...</div>
            <div class="context-menu-item context-menu-danger" @onclick="DeleteSelected">Delete</div>
        }
    </div>
}

@* Settings overlay *@
@if (showSettings)
{
    <div class="settings-overlay" @onclick="CloseSettings">
        <div class="settings-screen" @onclick:stopPropagation>
            <div class="settings-section">
                <h3>Database</h3>
                @if (DbPathService.HasDatabasePath())
                {
                    <div class="current-db-path">@DbPathService.GetDatabasePath()</div>
                }
                else
                {
                    <div class="current-db-path no-db-path">No database selected</div>
                }
                <button class="btn-secondary" @onclick="ChangeDatabase">
                    @(IsDesktop ? "Change Database" : "Select Database")
                </button>
                @if (IsDesktop)
                {
                    <button class="btn-primary" style="margin-left: 0.5rem;" @onclick="CreateNewDatabase">
                        Create New
                    </button>
                }
            </div>
            <div class="settings-section">
                <h3>Application</h3>
                <div style="font-size: 0.875rem; color: var(--text-secondary); line-height: 1.4;">
                    <div>Version: <strong>@BuildInfo.Version</strong></div>
                    <div>Build date: <strong>@BuildInfo.BuildDate.ToLocalTime().ToString("g")</strong></div>
                </div>
            </div>
        </div>
    </div>
}

@* Toast notification *@
@if (showToast)
{
    <div class="toast">@toastMessage</div>
}

@* Error dialog *@
@if (showError)
{
    <div class="settings-overlay" @onclick="CloseError">
        <div class="settings-screen error-dialog" @onclick:stopPropagation>
            <div class="settings-section">
                <h3 style="color: var(--danger);">Error</h3>
                <p>@errorMessage</p>
                <button class="btn-primary" @onclick="CloseError">OK</button>
            </div>
        </div>
    </div>
}

@code {
    // Platform detection
#if DESKTOP
    private bool IsDesktop => true;
    [Inject] private FileOperationsService FileOps { get; set; } = default!;
    [Inject] private ActivityLogService ActivityLog { get; set; } = default!;
    [Inject] private ArchiveService ArchiveSvc { get; set; } = default!;
#else
    private bool IsDesktop => false;
    private bool IsSelectedFileArchive() => false;
    private void OpenSelectedFile() { }
    private void OpenSelectedFolder() { }
    private void StartRename() { }
    private void StartExtract() { }
    private void StartExtractAndDelete() { }
    private void StartCopy() { }
    private void StartMove() { }
    private void DeleteSelected() { }
#endif

    // Tab state
    private string activeTab = "search";
    private CollectionsView? collectionsViewRef;

    // Search state
    private string searchQuery = "";
    private List<Collection> availableCollections = new();
    private HashSet<int> selectedCollectionIds = new();
    private int totalCount;
    private FileTypeFilter fileTypeFilter = FileTypeFilter.All;
    private bool showFolders = true;

    private Virtualize<IndexedFile>? virtualizeRef;

    // Sort state
    private SortColumn sortColumn = SortColumn.Name;
    private bool sortAsc = true;

    // Selection state
    private HashSet<long> selectedFileIds = new();
    private List<IndexedFile> currentFiles = new();

    // Context menu state
    private bool contextMenuVisible;
    private double contextMenuX;
    private double contextMenuY;

    // UI state
    private bool showSettings;
    private bool showToast;
    private bool showError;
    private string toastMessage = "";
    private string errorMessage = "";

    // Theme state
    private bool isLightTheme;

    private System.Timers.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += (s, e) => RefreshListSafe();

        isLightTheme = Preferences.Default.Get("theme", "dark") == "light";

        await LoadCollections();
        await RefreshList();
    }

    private bool _themeApplied;

    private bool _contextMenuNeedsAdjust;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_themeApplied)
        {
            _themeApplied = true;
            await ApplyTheme();
            try { await JS.InvokeVoidAsync("initColumnResize", ".file-list-table"); } catch { }
        }
        if (_contextMenuNeedsAdjust)
        {
            _contextMenuNeedsAdjust = false;
            try { await JS.InvokeVoidAsync("adjustContextMenu"); } catch { }
        }
    }

    private async Task LoadCollections()
    {
        try
        {
            availableCollections = await Collections.GetAllAsync();
            selectedCollectionIds = availableCollections.Select(c => c.Id).ToHashSet();
        }
        catch
        {
            availableCollections = new();
        }
    }

    private async Task OnCollectionsChanged()
    {
        await LoadCollections();
        await RefreshList();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void OnSearchKeyUp()
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async ValueTask<ItemsProviderResult<IndexedFile>> LoadFilesAsync(ItemsProviderRequest request)
    {
        try
        {
            var collectionIds = selectedCollectionIds.Count == availableCollections.Count
                ? null
                : selectedCollectionIds.AsEnumerable();

            var (cleanQuery, directoryFilter) = ParseSearchQuery(searchQuery);

            var effectiveSortColumn = sortColumn;
            var effectiveDirection = sortAsc ? SortDirection.Asc : SortDirection.Desc;

            if (!string.IsNullOrWhiteSpace(cleanQuery) && sortColumn == SortColumn.Name && sortAsc)
            {
                effectiveSortColumn = SortColumn.Rank;
                effectiveDirection = SortDirection.Asc;
            }

            var result = await Search.SearchWithSortAsync(
                cleanQuery,
                effectiveSortColumn,
                effectiveDirection,
                request.Count,
                request.StartIndex,
                collectionIds,
                GetExtensionFilter(),
                directoryFilter,
                GetShowDirectories());

            totalCount = result.TotalCount;
            currentFiles = result.Files;
            await InvokeAsync(StateHasChanged);

            return new ItemsProviderResult<IndexedFile>(result.Files, result.TotalCount);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Search error: {ex.Message}");
            totalCount = 0;
            return new ItemsProviderResult<IndexedFile>(new List<IndexedFile>(), 0);
        }
    }

    private static readonly System.Text.RegularExpressions.Regex DirFilterRegex = new(
        @"dir:""([^""]+)""|dir:(\S+)",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private (string cleanQuery, string? directoryFilter) ParseSearchQuery(string query)
    {
        string? directoryFilter = null;
        var clean = DirFilterRegex.Replace(query, m =>
        {
            directoryFilter = m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value;
            return "";
        }).Trim();
        return (clean, directoryFilter);
    }

    private async Task FilterByFolder()
    {
        CloseContextMenu();
        var file = currentFiles.FirstOrDefault(f => selectedFileIds.Contains(f.Id));
        if (file != null)
        {
            searchQuery = $"dir:\"{file.Directory}\"";
            await RefreshList();
        }
    }

    private async Task RefreshList()
    {
        if (virtualizeRef != null)
        {
            await virtualizeRef.RefreshDataAsync();
        }
        StateHasChanged();
    }

    private void SetSort(SortColumn column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = column is SortColumn.Size or SortColumn.ModifiedAt ? false : true;
        }
        RefreshListSafe();
    }

    private void ToggleCollection(int id)
    {
        if (selectedCollectionIds.Contains(id))
            selectedCollectionIds.Remove(id);
        else
            selectedCollectionIds.Add(id);
        RefreshListSafe();
    }

    // Row interactions
    private void OnRowClick(MouseEventArgs e, IndexedFile file)
    {
        CloseContextMenu();

        if (e.CtrlKey)
        {
            if (selectedFileIds.Contains(file.Id))
                selectedFileIds.Remove(file.Id);
            else
                selectedFileIds.Add(file.Id);
        }
        else if (e.ShiftKey && selectedFileIds.Count > 0)
        {
            var lastId = selectedFileIds.Last();
            var fromIndex = currentFiles.FindIndex(f => f.Id == lastId);
            var toIndex = currentFiles.FindIndex(f => f.Id == file.Id);
            if (fromIndex >= 0 && toIndex >= 0)
            {
                var start = Math.Min(fromIndex, toIndex);
                var end = Math.Max(fromIndex, toIndex);
                for (var i = start; i <= end; i++)
                    selectedFileIds.Add(currentFiles[i].Id);
            }
        }
        else
        {
            selectedFileIds.Clear();
            selectedFileIds.Add(file.Id);
        }
    }

    private void OnRowContextMenu(MouseEventArgs e, IndexedFile file)
    {
        if (!selectedFileIds.Contains(file.Id))
        {
            selectedFileIds.Clear();
            selectedFileIds.Add(file.Id);
        }

        if (IsDesktop)
        {
            contextMenuX = e.ClientX;
            contextMenuY = e.ClientY;
            contextMenuVisible = true;
            _contextMenuNeedsAdjust = true;
        }
        else
        {
            CopyPathToClipboard(file.Path);
        }
    }

    private async void OnRowDoubleClick(IndexedFile file)
    {
#if DESKTOP
        var result = await FileOps.OpenFileAsync(file.Path);
        if (!result.IsSuccess)
            ShowError(result.ErrorMessage ?? "Failed to open file");
#else
        CopyPathToClipboard(file.Path);
#endif
    }

    private void CloseContextMenu()
    {
        contextMenuVisible = false;
    }

    // File operations (desktop only)
#if DESKTOP
    private bool IsSelectedFileArchive()
    {
        if (selectedFileIds.Count == 0) return false;
        return currentFiles.Any(f => selectedFileIds.Contains(f.Id) && ArchiveService.IsArchive(f.Name));
    }

    private async void OpenSelectedFile()
    {
        CloseContextMenu();
        var file = currentFiles.FirstOrDefault(f => selectedFileIds.Contains(f.Id));
        if (file != null)
        {
            var result = await FileOps.OpenFileAsync(file.Path);
            if (!result.IsSuccess)
                ShowError(result.ErrorMessage ?? "Failed to open file");
        }
    }

    private async void OpenSelectedFolder()
    {
        CloseContextMenu();
        var file = currentFiles.FirstOrDefault(f => selectedFileIds.Contains(f.Id));
        if (file != null)
        {
            var result = await FileOps.OpenFolderAsync(file.Path);
            if (!result.IsSuccess)
                ShowError(result.ErrorMessage ?? "Failed to open folder");
        }
    }

    private void StartRename()
    {
        CloseContextMenu();
        ShowToast("Rename not yet implemented in MAUI");
    }

    private void StartExtract() => DoExtract(deleteAfter: false);

    private void StartExtractAndDelete() => DoExtract(deleteAfter: true);

    private async void DoExtract(bool deleteAfter)
    {
        CloseContextMenu();
        if (selectedFileIds.Count == 0) return;

        var files = await FileOps.GetFilesByIdsAsync(selectedFileIds);
        var archives = files.Where(f => ArchiveService.IsArchive(f.Name)).ToList();
        if (archives.Count == 0) return;

        var label = deleteAfter ? "Extracting & deleting" : "Extracting";
        var activity = ActivityLog.StartActivity($"{label} {archives.Count} archive(s)");
        try
        {
            var successCount = 0;
            var errorCount = 0;
            var deletedIds = new List<long>();

            foreach (var file in archives)
            {
                var result = await ArchiveSvc.ExtractSmartAsync(file.Path);
                if (result.IsSuccess)
                {
                    successCount++;
                    if (deleteAfter)
                    {
                        deletedIds.Add(file.Id);
                    }
                }
                else
                {
                    errorCount++;
                }
            }

            if (deletedIds.Any())
            {
                await FileOps.DeleteFilesAsync(deletedIds);
                foreach (var id in deletedIds) selectedFileIds.Remove(id);
            }

            if (errorCount > 0)
            {
                ActivityLog.FailActivity(activity.Id, $"Extracted {successCount}, failed {errorCount}");
                ShowError($"Extraction completed with {errorCount} errors.");
            }
            else
            {
                ActivityLog.CompleteActivity(activity.Id);
                ShowToast($"Extracted {successCount} archive(s)");
            }
            await RefreshList();
        }
        catch (Exception ex)
        {
            ActivityLog.FailActivity(activity.Id, ex.Message);
            ShowError($"Extraction failed: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void StartCopy()
    {
        CloseContextMenu();
        var destFolder = await FolderPicker.PickFolderAsync();
        if (destFolder != null)
        {
            var count = selectedFileIds.Count;
            var activity = ActivityLog.StartActivity($"Copying {count} file(s) to \"{destFolder}\"");
            var result = await FileOps.CopyFilesAsync(selectedFileIds, destFolder, HandleConflict);
            if (result.IsSuccess)
            {
                ActivityLog.CompleteActivity(activity.Id);
                ShowToast("Files copied");
                await RefreshList();
            }
            else if (!result.IsCancelled)
            {
                ActivityLog.FailActivity(activity.Id, result.ErrorMessage ?? "Error");
                ShowError(result.ErrorMessage ?? "Failed to copy files");
            }
            else
            {
                ActivityLog.CompleteActivity(activity.Id);
            }
        }
    }

    private async void StartMove()
    {
        CloseContextMenu();
        var destFolder = await FolderPicker.PickFolderAsync();
        if (destFolder != null)
        {
            var count = selectedFileIds.Count;
            var activity = ActivityLog.StartActivity($"Moving {count} file(s) to \"{destFolder}\"");
            var result = await FileOps.MoveFilesAsync(selectedFileIds, destFolder, HandleConflict);
            if (result.IsSuccess)
            {
                ActivityLog.CompleteActivity(activity.Id);
                ShowToast("Files moved");
                selectedFileIds.Clear();
                await RefreshList();
            }
            else if (!result.IsCancelled)
            {
                ActivityLog.FailActivity(activity.Id, result.ErrorMessage ?? "Error");
                ShowError(result.ErrorMessage ?? "Failed to move files");
            }
            else
            {
                ActivityLog.CompleteActivity(activity.Id);
            }
        }
    }

    private async void DeleteSelected()
    {
        CloseContextMenu();
        var count = selectedFileIds.Count;
        var activity = ActivityLog.StartActivity($"Deleting {count} file(s)");
        var result = await FileOps.DeleteFilesAsync(selectedFileIds);
        if (result.IsSuccess)
        {
            ActivityLog.CompleteActivity(activity.Id);
            ShowToast("Files deleted");
            selectedFileIds.Clear();
            await RefreshList();
        }
        else
        {
            ActivityLog.FailActivity(activity.Id, result.ErrorMessage ?? "Error");
            ShowError(result.ErrorMessage ?? "Failed to delete files");
        }
    }

    private Task<ConflictResolution> HandleConflict(string fileName, string destPath)
    {
        return Task.FromResult(ConflictResolution.KeepBoth);
    }
#endif

    private async void CopySelectedPaths()
    {
        CloseContextMenu();
        var paths = currentFiles
            .Where(f => selectedFileIds.Contains(f.Id))
            .Select(f => f.Path);
        var text = string.Join(Environment.NewLine, paths);
        await CopyToClipboard(text);
        ShowToast("Path copied");
    }

    private async void CopyPathToClipboard(string path)
    {
        await CopyToClipboard(path);
        ShowToast("Path copied");
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(text);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Clipboard error: {ex.Message}");
        }
    }

    // Theme
    private async Task ToggleTheme()
    {
        isLightTheme = !isLightTheme;
        var theme = isLightTheme ? "light" : "dark";
        Preferences.Default.Set("theme", theme);
        await ApplyTheme();
    }

    private async Task ApplyTheme()
    {
        var cssClass = isLightTheme ? "light-theme" : "";
        await JS.InvokeVoidAsync("themeInterop.setTheme", cssClass);
    }

    // Settings
    private void OpenSettings()
    {
        showSettings = true;
    }

    private void CloseSettings()
    {
        showSettings = false;
    }

    private async void ChangeDatabase()
    {
        var path = await FolderPicker.PickDatabaseFileAsync();
        if (path != null)
        {
            DbPathService.SetDatabasePath(path);
            showSettings = false;
            await LoadCollections();
            await RefreshList();
        }
    }

    private async void CreateNewDatabase()
    {
#if DESKTOP
        var folder = await FolderPicker.PickFolderAsync();
        if (folder != null)
        {
            var dbPath = Path.Combine(folder, "fileindex.db");
            DbPathService.SetDatabasePath(dbPath);
            showSettings = false;
            await LoadCollections();
            ShowToast("New database created");
        }
#endif
    }

    // UI helpers
    private void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            showToast = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        showError = true;
        StateHasChanged();
    }

    private void CloseError()
    {
        showError = false;
    }

    // Type filter
    private static readonly string[] ArchiveExtensions = { ".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz", ".tgz", ".tbz2", ".txz" };

    private IEnumerable<string>? GetExtensionFilter()
    {
        return fileTypeFilter == FileTypeFilter.Archives ? ArchiveExtensions : null;
    }

    private bool? GetShowDirectories()
    {
        return showFolders ? null : false;
    }

    private void ToggleShowFolders()
    {
        showFolders = !showFolders;
        RefreshListSafe();
    }

    private void SetTypeFilter(FileTypeFilter filter)
    {
        fileTypeFilter = filter;
        RefreshListSafe();
    }

    private enum FileTypeFilter
    {
        All,
        Archives
    }

    private void RefreshListSafe()
    {
        _ = Task.Run(async () =>
