@inject DatabaseManager Databases
@inject IndexDbContext Db
@inject NavigationManager Navigation
@inject UiFeedback Feedback

<div class="settings-group">
    <label class="settings-label">Database</label>
    <div class="current-db-path">@(Databases.CurrentPath ?? "No database selected")</div>
    @if (Databases.CopiesIntoAppStorage)
    {
        <p class="field-hint">A copy is kept on this device. Select the synced file again to refresh it.</p>
    }
    <div class="settings-actions">
        <button class="btn-secondary" @onclick="Select">
            @(Databases.CopiesIntoAppStorage ? "Select / refresh" : "Change database")
        </button>
        @if (!Databases.CopiesIntoAppStorage)
        {
            <button class="btn-primary" @onclick="Create">Create new</button>
        }
    </div>
    @if (error != null)
    {
        <span class="field-error">@error</span>
    }
</div>

@code {
    private string? error;

    private async Task Select()
    {
        (var changed, error) = await Databases.SelectAsync(Db);
        if (changed) Reload();
    }

    private async Task Create()
    {
        error = null;
        try
        {
            var folder = await Feedback.PickFolderAsync();
            if (folder == null) return;
            Databases.Create(Db, folder);
            Reload();
        }
        catch (Exception ex)
        {
            error = $"Cannot create the database: {ex.Message}";
        }
    }

    // Rebuild every component so nothing keeps showing data from the previous database.
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
