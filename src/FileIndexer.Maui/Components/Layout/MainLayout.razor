@inherits LayoutComponentBase
@inject DatabaseManager Databases
@inject IndexDbContext Db
@implements IDisposable

@if (!Databases.HasDatabase)
{
    <div class="setup-screen">
        <div class="setup-icon">📁</div>
        <h1 class="setup-title">FileIndexer</h1>
        <p class="setup-description">Select your synced database file to start searching your files.</p>
        <button class="btn-primary" @onclick="SelectDatabase">Select Database File</button>
        @if (error != null)
        {
            <p class="field-error">@error</p>
        }
    </div>
}
else
{
    @Body
}

@code {
    private string? error;

    protected override void OnInitialized() => Databases.Changed += OnDatabaseChanged;

    private void OnDatabaseChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SelectDatabase()
    {
        (_, error) = await Databases.SelectAsync(Db);
    }

    public void Dispose() => Databases.Changed -= OnDatabaseChanged;
}
