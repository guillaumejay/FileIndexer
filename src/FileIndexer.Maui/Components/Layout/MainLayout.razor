@inherits LayoutComponentBase
@inject DatabasePathService DbPathService
@inject IMauiFolderPickerService FolderPicker

<div class="page-container">
    @if (!DbPathService.HasDatabasePath())
    {
        <div class="setup-screen">
            <div class="setup-icon">📁</div>
            <h1 class="setup-title">FileIndexer</h1>
            <p class="setup-description">
                Select your synced database file to start searching your files.
            </p>
            <button class="btn-primary" @onclick="SelectDatabase">
                Select Database File
            </button>
        </div>
    }
    else
    {
        <ErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="setup-screen" style="color: var(--danger);">
                    <h2>Error</h2>
                    <pre style="white-space: pre-wrap; font-size: 0.8rem; max-width: 90vw; overflow: auto;">@ex.ToString()</pre>
                    <button class="btn-primary" style="margin-top: 1rem;" @onclick="ResetError">Retry</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
</div>

@if (showToast)
{
    <div class="toast">@toastMessage</div>
}

@code {
    private ErrorBoundary? errorBoundary;
    private bool showToast;
    private string toastMessage = "";

    private void ResetError()
    {
        errorBoundary?.Recover();
    }

    private async Task SelectDatabase()
    {
        var path = await FolderPicker.PickDatabaseFileAsync();
        if (path != null)
        {
            DbPathService.SetDatabasePath(path);
            StateHasChanged();
        }
    }

    public void ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        StateHasChanged();

        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            showToast = false;
            InvokeAsync(StateHasChanged);
        });
    }
}
